generator client {
  provider = "prisma-postgres-green-plank"
}

datasource db {
  provider = "postgresql"
  url      = env("MYRKLS_DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([expires])
  @@index([refreshTokenExpires])
}

model StoreConnectionCheck {
  shop             String   @id
  storeName        String
  myshopifyDomain  String
  apiVersion       String
  lastAttemptAt    DateTime @default(now())
  lastSuccessfulAt DateTime?
  lastError        String?
}

model RateLimitBucket {
  shop             String
  action           String
  windowStartedAt  DateTime @default(now())
  requestCount     Int      @default(0)
  expiresAt        DateTime

  @@id([shop, action])
  @@index([expiresAt])
}
