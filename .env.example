# Public Storefront API settings.
# Create a public Storefront API token for this storefront; never use an Admin token here.
VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
VITE_SHOPIFY_API_VERSION=2026-10

# Analytics are disabled unless explicitly enabled for the deployment environment.
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ENABLE_IN_DEVELOPMENT=false
VITE_GTM_ID=
VITE_META_PIXEL_ID=

# Server-side Shopify Admin API only. Never prefix these with VITE_.
# Grant only read_metaobject_definitions and read_metafield_definitions for preflight.
# Add definition-write scopes only after store-owner approval for --apply.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-10

# Explicit approval gates for the local schema deployment script.
# Set these only after the store owner has approved the exact schema and reviewed existing values.
SHOPIFY_CMS_SCHEMA_APPROVED=false
SHOPIFY_CMS_SCHEMA_METAFIELD_DATA_REVIEWED=false
